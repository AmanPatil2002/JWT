const db = require("../config/database");

const addInterested = (req, res) => {
    const { requesterEmail, profileId, intrest } = req.body;

    if (!requesterEmail || !profileId) {
        return res.status(400).json({
            error: "requesterEmail and profileId are required"
        });
    }

    const interestValue = intrest || "Interested"; // default value

    db.query(
        "SELECT id FROM interested WHERE RequesterEmail = ? AND ProfileID = ?",
        [requesterEmail, profileId],
        (err, existing) => {
            if (err) {
                console.error("Error checking existing interest:", err);
                return res.status(500).json({ error: "Database error", details: err.message });
            }
            if (existing.length > 0) {
                return res.status(409).json({
                    error: "Interest already exists for this profile",
                    existingId: existing[0].id
                });
            }

            const sql = `INSERT INTO interested (RequesterEmail, ProfileID, Intrest) VALUES (?, ?, ?)`;
            const values = [requesterEmail, profileId, interestValue];

            db.query(sql, values, (err, result) => {
                if (err) {
                    console.error("Database error:", err);
                    return res.status(500).json({
                        error: "Failed to create interest",
                        details: err.message
                    });
                }

                res.status(201).json({
                    message: "Interest created successfully",
                    interest: {
                        ID: result.insertId,
                        RequesterEmail: requesterEmail,
                        ProfileID: profileId,
                        Intrest: interestValue
                    }
                });
            });
        }
    );
};



const getInterested = (req, res) => {
    const { email } = req.params;
    if (!email) {
        return res.status(400).json({
            error: "Email is required"
        });
    }
    const sql = `
        SELECT
            i.ID,
            i.RequesterEmail,
            i.ProfileID,
            p.*
        FROM interested i
        INNER JOIN profile p
            ON p.RegisterID = i.ProfileID
        WHERE i.RequesterEmail = ?
        ORDER BY i.CreatedAt DESC
    `;

    db.query(sql, [email], (err, results) => {
        if (err) {
            console.error("Error fetching interested profiles:", err);
            return res.status(500).json({
                error: "Database error",
                details: err.message
            });
        }
        res.status(200).json(results);
    });
};

