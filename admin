                                                            <Box sx={{ mb: 1 }}>
                                                                <Chip
                                                                    label={`${info.Age} yrs`}
                                                                    size="small"
                                                                    color="black"
                                                                    sx={{ mr: 1, mb: 1 }}
                                                                />
                                                                {info.Status == "Single"
                                                                    ? (
                                                                        <Chip label={info.Status} size="small"
                                                                            variant="outlined"

                                                                            sx={{ mr: 1, mb: 1, color: '#66BB6A', }} />
                                                                    ) : (
                                                                        <Chip label={info.Status} size="small"
                                                                            variant="outlined"
                                                                            color="primary"
                                                                            sx={{ mr: 1, mb: 1, color: '#2c73d2', }} />
                                                                    )}
                                                            </Box>
                                                            <Box sx={{ display: 'flex', mt: 1, color: 'text.secondary', justifyContent: 'center' }}>
                                                                <EmailIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                                <Typography variant="body2" noWrap>
                                                                    {info.Email || 'Not specified'}
                                                                </Typography>
                                                            </Box>
                                                            <Box sx={{ display: 'flex', mt: 0.5, color: 'text.secondary', justifyContent: 'center' }}>
                                                                <CallIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                                <Typography variant="body2" noWrap>
                                                                    {info.Contact || 'Not specified'}
                                                                </Typography>
                                                            </Box>
                                                        </CardContent>
                                                    </ProfileCard>
                                                ) : (null)
                                            ))}
                                        </TableCell>
                                        <TableCell align="center" className="py-4">
                                            <Box sx={{ flexGrow: 1 }}>
                                                <Grid container spacing={1} >
                                                    <Grid size="grow">
                                                        {profile.map((info) => (
                                                            user.RequesterEmail == info.Email ? (
                                                                <Item>
                                                                    {info.Gender === 'Female' ?
                                                                        <GirlIcon sx={{ fontSize: { xs: 50, md: 50 }, color: '#f8bbd0', background: 'rgb(245, 118, 160)', }} />
                                                                        :
                                                                        <BoyIcon sx={{ fontSize: { xs: 50, md: 50 }, color: '#bbdefb', background: 'rgb(29, 156, 248)', }} />
                                                                    }
                                                                </Item>
                                                            ) : (null)
                                                        ))}
                                                    </Grid>
                                                        {user.Intrest == "Yes" ? (
                                                            <Grid size={8}>
                                                                 <FavoriteIcon sx={{color:'red',fontSize:60}}/>
                                                                 <Typography variant="body1">
                                                                    Both Share Intrest
                                                                </Typography>
                                                            </Grid>
                                                        ) : user.Intrest == "No" ? (
                                                            <Grid size={8}>
                                                                 <BlockIcon sx={{color:'black',fontSize:60}}/>
                                                                 <Typography variant="body1">
                                                                    Rejected Intrest
                                                                </Typography>
                                                            </Grid>
                                                        ) : (
                                                            <Grid size={8}>
                                                                Intrested                                            
                                                                <ArrowForwardIcon sx={{fontSize:40}}/>
                                                                <Typography variant="body1">
                                                                    {new Date(user.CreatedAt).toLocaleString("en-IN", {
                                                                        day: "2-digit",
                                                                        month: "long",
                                                                        year: "numeric",
                                                                        hour: "2-digit",
                                                                        minute: "2-digit",
                                                                        hour12: true,
                                                                    })}
                                                                </Typography>
                                                            </Grid>
                                                        )}                                                    
                                                    <Grid size="grow">
                                                        {profile.map((info) => (
                                                            user.ProfileID == info.RegisterID ? (
                                                                <Item>
                                                                    {info.Gender === 'Female' ?
                                                                        <GirlIcon sx={{ fontSize: { xs: 50, md: 50 }, color: '#f8bbd0', background: 'rgb(245, 118, 160)', }} />
                                                                        :
                                                                        <BoyIcon sx={{ fontSize: { xs: 50, md: 50 }, color: '#bbdefb', background: 'rgb(29, 156, 248)', }} />
                                                                    }
                                                                </Item>
                                                            ) : (null)
                                                        ))}
                                                    </Grid>
                                                </Grid>
                                            </Box>
                                        </TableCell>
                                        <TableCell align="center" className="py-4 text-gray-600">
                                            <Grid container rowSpacing={1}>
                                                <Grid size={12}>
                                                    {profile.map((info) => (
                                                        user.ProfileID == info.RegisterID ? (
                                                            <ProfileCard key={info.RegisterID}>
                                                                <CardMedia
                                                                    component="div"
                                                                    sx={{
                                                                        height: 200,
                                                                        background: info.Gender === 'Female'
                                                                            ? 'linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                                                                            : 'linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)',
                                                                        display: 'flex',
                                                                        alignItems: 'center',
                                                                        justifyContent: 'center',
                                                                    }}
                                                                >
                                                                    <Avatar
                                                                        src={info.Image}
                                                                        alt={info.Name}
                                                                        sx={{
                                                                            width: 120,
                                                                            height: 120,
                                                                            border: '4px solid white',
                                                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                                                        }}
                                                                    >
                                                                        <PersonIcon sx={{ fontSize: 60, color: '#9e9e9e' }} />
                                                                    </Avatar>
                                                                </CardMedia>
                                                                <CardContent sx={{ textAlign: 'center' }}>
                                                                    <Typography variant="h6" gutterBottom sx={{ color: '#c2185b' }}>
                                                                        {info.Name}
                                                                    </Typography>
                                                                    <Box sx={{ mb: 1 }}>
                                                                        <Chip
                                                                            label={`${info.Age} yrs`}
                                                                            size="small"
                                                                            color="black"
                                                                            sx={{ mr: 1, mb: 1 }}
                                                                        />

                                                                        {info.Status == "Single"
                                                                            ? (
                                                                                <Chip label={info.Status} size="small"
                                                                                    variant="outlined"

                                                                                    sx={{ mr: 1, mb: 1, color: '#66BB6A', }} />
                                                                            ) : (
                                                                                <Chip label={info.Status} size="small"
                                                                                    variant="outlined"
                                                                                    color="primary"
                                                                                    sx={{ mr: 1, mb: 1, color: '#2c73d2', }} />
                                                                            )}
                                                                    </Box>
                                                                    <Box sx={{ display: 'flex', mt: 1, color: 'text.secondary', justifyContent: 'center' }}>
                                                                        <EmailIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                                        <Typography variant="body2" noWrap>
                                                                            {info.Email || 'Not specified'}
                                                                        </Typography>
                                                                    </Box>
                                                                    <Box sx={{ display: 'flex', mt: 0.5, color: 'text.secondary', justifyContent: 'center' }}>
                                                                        <CallIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                                        <Typography variant="body2" noWrap>
                                                                            {info.Contact || 'Not specified'}
                                                                        </Typography>
                                                                    </Box>
                                                                </CardContent>
                                                            </ProfileCard>
                                                        ) : (null)
                                                    ))}
                                                </Grid>
                                            </Grid>
                                        </TableCell>
                                    </TableRow>
                                );
                            })}
                        </TableBody>
                    </Table>
                </TableContainer>
            </Paper>
        </Box>
    );
}
















