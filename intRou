const express = require("express");
const router = express.Router();
const {
    postIntrest,
    getInterested,
    AllInterested,
    updateInterest,
    getYesInterested,
    getNoInterested
} = require("../controller/intrestcontroller");


router.post("/intrest", postIntrest);
router.get("/intrest/sent/:email", getInterested);
router.get("/intrest",AllInterested)
router.put("/intrest/:email", updateInterest);
router.get("/status/No/:email", getNoInterested);
router.get("/status/Yes/:email", getYesInterested);

module.exports = router;
