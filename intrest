const fetchInterestedProfiles = async () => {
    setLoading(true);
    setError(false);

    try {
        const res = await axios.get(
            `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`
        );
        const interests = Array.isArray(res.data) ? res.data : [];

        // Only keep profiles where interest is confirmed as "Yes"
        const onlyYes = interests.filter(
            (p) => p.Intrest?.toLowerCase() === "yes"
        );

        setProfiles(onlyYes);
        setFilteredProfiles(onlyYes);
    } catch (err) {
        console.error(
            "Error fetching interested profiles:",
            err.response?.data || err.message
        );
        setProfiles([]);
        setFilteredProfiles([]);
        setError(true);
    } finally {
        setLoading(false);
    }
};
