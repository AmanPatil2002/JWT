import {
    Box,
    Container,
    CssBaseline,
    Grid,
    Paper,
    Typography,
    Divider,
    Card,
    CardContent,
    CardMedia,
    Avatar,
    Chip,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    Skeleton,
} from "@mui/material";
import { styled } from "@mui/material/styles";
import PersonIcon from '@mui/icons-material/Person';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import SchoolIcon from '@mui/icons-material/School';
import EmailIcon from '@mui/icons-material/Email';
import AccessibleIcon from '@mui/icons-material/Accessible';
import AccessibilityIcon from '@mui/icons-material/Accessibility';
import FavoriteIcon from '@mui/icons-material/Favorite';
import HeightIcon from '@mui/icons-material/Height';
import WhatsAppIcon from '@mui/icons-material/WhatsApp';
import InfoIcon from '@mui/icons-material/Info';
import CalendarMonthIcon from '@mui/icons-material/CalendarMonth';
import { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";

import axios from "axios";

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000';

const StyledPaper = styled(Paper)(({ theme }) => ({
    padding: theme.spacing(3),
    borderRadius: 16,
    boxShadow: '0 8px 32px rgba(0,0,0,0.1)',
    [theme.breakpoints.down('sm')]: {
        padding: theme.spacing(2),
        borderRadius: 12,
    },
}));

const ProfileCard = styled(Card)(() => ({
    height: '100%',
    transition: 'transform 0.3s, box-shadow 0.3s',
    cursor: 'pointer',
    position: 'relative',
    overflow: 'visible',
    '&:hover': {
        transform: 'translateY(-8px)',
        boxShadow: '0 12px 40px rgba(0,0,0,0.15)',
    },
}));

const IntrestCard = styled(Card)(() => ({
    height: '100%',
    transition: 'transform 0.3s, box-shadow 0.3s',
    cursor: 'pointer',
    position: 'relative',
    overflow: 'visible',
}));


export default function Intrest() {
    const navigate = useNavigate();
    const [profiles, setProfiles] = useState([]);
    const [filteredProfiles, setFilteredProfiles] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(false);
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [detailOpen, setDetailOpen] = useState(false);
    const [intrested, setIntrested] = useState("");
    const currentUserEmail = localStorage.getItem('email');

    useEffect(() => {
        if (currentUserEmail) {
            fetchInterestedProfiles([]);
        } else {
            setProfiles([]);
            setFilteredProfiles([]);
            setLoading(false);
        }
    }, [currentUserEmail]);

    const fetchInterestedProfiles = async () => {
        setLoading(true);
        setError(false);

        try {
            const res = await axios.get(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`
            );
            console.log("Fetched interests:", res.data);
            const interests = Array.isArray(res.data)
                ? res.data
                : [];

            setProfiles(interests);
            setFilteredProfiles(interests);

        } catch (err) {
            console.error(
                "Error fetching interested profiles:",
                err.response?.data || err.message
            );

            setProfiles([]);
            setFilteredProfiles([]);
            setError(true);
        } finally {
            setLoading(false);
        }
    };

    //----------------------------------------------------------------------------------------------------------------------------------

    const Addintrest = async (profile) => {
        setLoading(true);
        try {
            const res = await axios.put(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
                {
                    intrest: intrested,
                    requesterEmail: currentUserEmail,
                    profileId: profile.RegisterID,
                }
            );
            console.log("Interest updated:", res.data);
            setIntrested("");

        } catch (err) {
            console.error(
                "Error updating interest:",
                err.response?.data || err.message
            );
        } finally {
            setLoading(false);
        }
    };

    const deleteintrest = async (profile) => {
        setLoading(true);

        try {
            const res = await axios.delete(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
                {
                    data: {
                        requesterEmail: currentUserEmail,
                        profileId: profile.RegisterID,
                    },
                }
            );
            console.log("Interest deleted:", res.data);
        } catch (err) {
            console.error(
                "Error deleting interest:",
                err.response?.data || err.message
            );
        } finally {
            setLoading(false);
        }
    };


    //----------------------------------------------------------------------------------------------------------------------------

    const handleProfileClick = (profile) => {
        setSelectedProfile(profile);
        setDetailOpen(true);
    };


    const getImageUrl = (imagePath) => {
        if (!imagePath) return null;
        if (imagePath.startsWith('http')) return imagePath;
        const cleanPath = imagePath.replace(/^\/+/, '');
        return `${API_URL}/${cleanPath}`;
    };

    const ProfileDetailDialog = () => (
        <Dialog
            open={detailOpen}
            onClose={() => setDetailOpen(false)}
            fullWidth
            maxWidth="lg"
            scroll="paper"
            sx={{
                '& .MuiDialog-paper': {
                    width: {
                        xs: 'calc(100% - 24px)',
                        sm: 'calc(100% - 32px)',
                        md: '90%',
                        lg: '80%',
                    },
                    maxWidth: '1400px',
                    maxHeight: '95vh',
                    m: { xs: 1.5, sm: 2 },
                    borderRadius: { xs: 2, sm: 3 },
                },
            }}
        >
            {selectedProfile && (
                <>
                    <DialogTitle
                        sx={{
                            display: 'flex',
                            justifyContent: 'space-between',
                            alignItems: 'center',
                            background:
                                selectedProfile.Gender === 'Female'
                                    ? 'linear-gradient(135deg, rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                                    : 'linear-gradient(135deg, rgb(29, 156, 248) 0%, #bbdefb 100%)',
                            color: 'white',
                            px: { xs: 2, sm: 3 },
                            py: { xs: 1.5, sm: 2 },
                        }}
                    >
                        <Typography
                            variant="h5"
                            fontWeight="bold"
                            sx={{
                                width: '100%',
                                textAlign: 'center',
                                fontSize: {
                                    xs: '1.15rem',
                                    sm: '1.4rem',
                                    md: '1.5rem',
                                },
                            }}
                        >
                            {selectedProfile.Name}'s Profile
                        </Typography>
                    </DialogTitle>

                    <DialogContent
                        dividers
                        sx={{
                            p: {
                                xs: 1.5,
                                sm: 2,
                                md: 3,
                            },
                            overflowX: 'hidden',
                        }}
                    >
                        <Grid
                            container
                            spacing={{ xs: 2, md: 3 }}
                        >
                            <Grid size={{ xs: 12, md: 4 }}>
                                <Box
                                    sx={{
                                        textAlign: 'center',
                                        position: 'sticky',
                                        top: 0,
                                    }}
                                >
                                    <Avatar
                                        src={getImageUrl(selectedProfile.Image)}
                                        alt={selectedProfile.Name}
                                        variant="rounded"
                                        sx={{
                                            width: {
                                                xs: 180,
                                                sm: 220,
                                                md: 260,
                                                lg: 300,
                                            },
                                            height: {
                                                xs: 240,
                                                sm: 290,
                                                md: 350,
                                                lg: 400,
                                            },
                                            maxWidth: '100%',
                                            mx: 'auto',
                                            mb: 2,
                                            borderRadius: 2,
                                            boxShadow:
                                                '0 4px 12px rgba(0,0,0,0.1)',
                                        }}
                                    >
                                        <PersonIcon
                                            sx={{
                                                fontSize: {
                                                    xs: 70,
                                                    sm: 90,
                                                    md: 100,
                                                },
                                            }}
                                        />
                                    </Avatar>

                                    <Typography
                                        variant="h6"
                                        gutterBottom
                                        sx={{
                                            fontSize: {
                                                xs: '1rem',
                                                sm: '1.15rem',
                                            },
                                            wordBreak: 'break-word',
                                        }}
                                    >
                                        {selectedProfile.Name}
                                    </Typography>

                                    <Box>
                                        {selectedProfile.Status === 'Single' ? (
                                            <Chip
                                                label={selectedProfile.Status}
                                                size="small"
                                                variant="outlined"
                                                sx={{
                                                    mr: 1,
                                                    mb: 1,
                                                    color: '#66BB6A',
                                                }}
                                            />
                                        ) : (
                                            <Chip
                                                label={selectedProfile.Status}
                                                size="small"
                                                variant="outlined"
                                                sx={{
                                                    mr: 1,
                                                    mb: 1,
                                                    color: '#2c73d2',
                                                }}
                                            />
                                        )}
                                    </Box>
                                    <Box>
                                        {selectedProfile.Physically === 'Yes' ? (
                                            <Typography
                                                variant="body2"
                                                color="warning"
                                            >
                                                <AccessibleIcon
                                                    fontSize="small"
                                                    sx={{
                                                        verticalAlign: 'middle',
                                                        mr: 0.5,
                                                    }}
                                                />
                                                Physically Challenged
                                            </Typography>
                                        ) : (
                                            <Typography
                                                variant="body2"
                                                color="success"
                                            >
                                                <AccessibilityIcon
                                                    fontSize="small"
                                                    sx={{
                                                        verticalAlign: 'middle',
                                                        mr: 0.5,
                                                    }}
                                                />
                                                Not Physically Challenged
                                            </Typography>
                                        )}
                                    </Box>
                                </Box>
                            </Grid>

                            <Grid size={{ xs: 12, md: 8 }}>
                                <Typography
                                    variant="h6"
                                    gutterBottom
                                    sx={{
                                        display: 'flex',
                                        alignItems: 'center',
                                        gap: 1,
                                        color: '#c2185b',
                                        fontSize: {
                                            xs: '1rem',
                                            sm: '1.15rem',
                                            md: '1.25rem',
                                        },
                                    }}
                                >
                                    <InfoIcon fontSize="small" />
                                    Personal Information
                                </Typography>

                                <Grid
                                    container
                                    spacing={{ xs: 1.5, sm: 2 }}
                                >
                                    <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Gender: </b>
                                            {selectedProfile.Gender ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Religion: </b>
                                            {selectedProfile.Religion ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Mother Tongue: </b>
                                            {selectedProfile.Language ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                        >
                                            <HeightIcon
                                                fontSize="small"
                                                sx={{
                                                    verticalAlign: 'middle',
                                                    mr: 0.5,
                                                }}
                                            />
                                            {selectedProfile.Height
                                                ? `${selectedProfile.Height} ft`
                                                : 'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 12, md: 8 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{
                                                display: 'flex',
                                                alignItems: 'flex-start',
                                                wordBreak: 'break-word',
                                            }}
                                        >
                                            <LocationOnIcon
                                                fontSize="small"
                                                sx={{
                                                    mr: 0.5,
                                                    flexShrink: 0,
                                                }}
                                            />
                                            {selectedProfile.Address ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6, md: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <CalendarMonthIcon
                                                fontSize="small"
                                                sx={{
                                                    verticalAlign: 'middle',
                                                    mr: 0.5,
                                                }}
                                            />
                                            {selectedProfile.DOB
                                                ? new Date(
                                                    selectedProfile.DOB
                                                ).toLocaleString('en-IN', {
                                                    day: '2-digit',
                                                    month: 'long',
                                                    year: 'numeric',
                                                })
                                                : 'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6, md: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                        >
                                            <AccessibilityIcon
                                                fontSize="small"
                                                sx={{
                                                    verticalAlign: 'middle',
                                                    mr: 0.5,
                                                }}
                                            />
                                            {selectedProfile.Age
                                                ? `${selectedProfile.Age} years`
                                                : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Divider sx={{ my: { xs: 2, md: 2.5 } }} />

                                <Typography
                                    variant="h6"
                                    gutterBottom
                                    sx={{
                                        display: 'flex',
                                        alignItems: 'center',
                                        gap: 1,
                                        color: '#c2185b',
                                        fontSize: {
                                            xs: '1rem',
                                            sm: '1.15rem',
                                            md: '1.25rem',
                                        },
                                    }}
                                >
                                    <SchoolIcon fontSize="small" />
                                    Education & Career
                                </Typography>

                                <Grid
                                    container
                                    spacing={{ xs: 1.5, sm: 2 }}
                                >
                                    <Grid size={{ xs: 12, sm: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Education: </b>
                                            {selectedProfile.Education ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Occupation: </b>
                                            {selectedProfile.Occupation ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Company: </b>
                                            {selectedProfile.CompanyName ||
                                                'Not specified'}
                                        </Typography>
                                    </Grid>

                                    <Grid size={{ xs: 12, sm: 6 }}>
                                        <Typography
                                            variant="body2"
                                            color="text.secondary"
                                            sx={{ wordBreak: 'break-word' }}
                                        >
                                            <b>Monthly Income: </b>
                                            {selectedProfile.MonthlyIncome
                                                ? `₹${parseInt(
                                                    selectedProfile.MonthlyIncome
                                                ).toLocaleString()}`
                                                : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Grid
                                    container
                                    spacing={{ xs: 2, md: 3 }}
                                    sx={{ mt: 0 }}
                                >
                                    {selectedProfile.Detail && (
                                        <Grid size={{ xs: 12, md: 6 }}>
                                            <Divider sx={{ my: 2 }} />

                                            <Typography
                                                variant="h6"
                                                gutterBottom
                                                sx={{
                                                    display: 'flex',
                                                    alignItems: 'center',
                                                    gap: 1,
                                                    color: '#c2185b',
                                                    fontSize: {
                                                        xs: '1rem',
                                                        sm: '1.15rem',
                                                        md: '1.25rem',
                                                    },
                                                }}
                                            >
                                                <FavoriteIcon fontSize="small" />
                                                About Me
                                            </Typography>

                                            <Paper
                                                sx={{
                                                    p: {
                                                        xs: 1.5,
                                                        sm: 2,
                                                    },
                                                    bgcolor: '#fdf2f8',
                                                    borderRadius: 2,
                                                    maxHeight: {
                                                        xs: 250,
                                                        md: 350,
                                                    },
                                                    overflowY: 'auto',
                                                }}
                                            >
                                                <Typography
                                                    variant="body1"
                                                    sx={{
                                                        whiteSpace: 'pre-line',
                                                        lineHeight: 1.8,
                                                        fontSize: {
                                                            xs: '0.9rem',
                                                            sm: '1rem',
                                                        },
                                                        overflowWrap: 'anywhere',
                                                    }}
                                                >
                                                    {selectedProfile.Detail}
                                                </Typography>
                                            </Paper>
                                        </Grid>
                                    )}

                                    <Grid
                                        size={{
                                            xs: 12,
                                            md: selectedProfile.Detail ? 6 : 12,
                                        }}
                                    >
                                        <Divider sx={{ my: 2 }} />
                                        <Typography
                                            variant="h6"
                                            gutterBottom
                                            sx={{
                                                display: 'flex',
                                                alignItems: 'center',
                                                gap: 1,
                                                color: '#c2185b',
                                                fontSize: {
                                                    xs: '1rem',
                                                    sm: '1.15rem',
                                                    md: '1.25rem',
                                                },
                                            }}
                                        >
                                            Contact
                                        </Typography>
                                        {selectedProfile.Member === 'Premium' ? (
                                            <Box
                                                sx={{
                                                    display: 'flex',
                                                    flexDirection: 'column',
                                                    gap: 1.5,
                                                    width: '100%',
                                                }}
                                            >
                                                <Button
                                                    color="success"
                                                    component="a"
                                                    href={
                                                        selectedProfile.Contact
                                                            ? `https://wa.me/${selectedProfile.Contact.replace(/\D/g, '')}`
                                                            : undefined
                                                    }
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    disabled={!selectedProfile.Contact}
                                                    variant="outlined"
                                                    startIcon={<WhatsAppIcon />}
                                                    sx={{ width: '100%', minHeight: 48, borderRadius: 2, justifyContent: 'center' }}
                                                >
                                                    WhatsApp
                                                </Button>

                                                <Button
                                                    color="primary"
                                                    component="a"
                                                    href={selectedProfile.Email ? `mailto:${selectedProfile.Email}` : undefined}
                                                    disabled={!selectedProfile.Email}
                                                    variant="outlined"
                                                    startIcon={<EmailIcon />}
                                                    sx={{ width: '100%', minHeight: 48, borderRadius: 2, justifyContent: 'center' }}
                                                >
                                                    Email
                                                </Button>
                                            </Box>
                                        ) : (
                                            <Button
                                                onClick={() => navigate('/profile')}
                                                variant="contained"
                                                fullWidth
                                                sx={{ minHeight: 48, borderRadius: 2 }}
                                            >
                                                Get Premium Subscription
                                            </Button>
                                        )}

                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DialogContent>

                    <DialogActions
                        sx={{
                            px: { xs: 1.5, sm: 3 },
                            py: { xs: 1.5, sm: 2 },
                        }}
                    >
                        <Button
                            onClick={() => setDetailOpen(false)}
                            variant="outlined"
                            fullWidth={false}
                            sx={{
                                minWidth: { xs: 90, sm: 100 },
                            }}
                        >
                            Close
                        </Button>
                    </DialogActions>
                </>
            )}
        </Dialog>
    );

    const ProfileCardSkeleton = () => (
        <Grid size={{ xs: 12, sm: 6, md: 4, lg: 3 }}>
            <Card>
                <Skeleton variant="rectangular" height={200} />
                <CardContent>
                    <Skeleton variant="text" width="60%" height={30} />
                    <Skeleton variant="text" width="40%" />
                    <Skeleton variant="text" width="80%" />
                </CardContent>
            </Card>
        </Grid>
    );

    return (
        <>

            <CssBaseline />
            <Box sx={{
                minHeight: '100vh',
                background: 'linear-gradient(135deg, rgb(163, 65, 65) 0%,rgb(232, 53, 37) 100%)',
                py: { xs: 2, sm: 3, md: 4 },
                px: { xs: 1, sm: 2, md: 0 },
            }}>
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>
                        <Box textAlign="center" mb={4}>
                            <Typography variant="h4" fontWeight="bold" sx={{ color: '#c2185b', textAlign: 'center' }}>
                                Intrested Profiles
                            </Typography>
                        </Box>

                        <Divider sx={{ mb: 3 }} />

                        {loading ? (
                            <Grid container spacing={3}>
                                {[...Array(8)].map((_, index) => (
                                    <ProfileCardSkeleton key={index} />
                                ))}
                            </Grid>
                        ) : error ? (
                            <Box textAlign="center" py={8}>
                                <PersonIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    Couldn't load your interested profiles
                                </Typography>
                                <Typography variant="body2" color="text.secondary" gutterBottom>
                                    Something went wrong. Please try again.
                                </Typography>
                                <Button
                                    variant="outlined"
                                    onClick={fetchInterestedProfiles}
                                    sx={{ mt: 2 }}
                                >
                                    Retry
                                </Button>
                            </Box>
                        ) : filteredProfiles.length === 0 ? (
                            <Box textAlign="center" py={8}>
                                <PersonIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    No Profiles Found
                                </Typography>

                            </Box>
                        ) : (
                            <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 8, md: 12 }}>
                                {filteredProfiles.map((profile) => (
                                    <Grid size={{ xs: 2, sm: 2, md: 3 }} key={profile.RegisterID}>

                                        {profile.Intrest ==="No" &&(
                                            <IntrestCard>
                                                <CardMedia
                                                    component="div"
                                                    sx={{
                                                        height: 200,
                                                        background:
                                                            profile.Gender === 'Female'
                                                                ? 'linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                                                                : 'linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)',
                                                        display: 'flex',
                                                        alignItems: 'center',
                                                        justifyContent: 'center',
                                                    }}
                                                >
                                                    <Avatar
                                                        src={getImageUrl(profile.Image)}
                                                        alt={profile.Name}
                                                        sx={{
                                                            width: 120,
                                                            height: 120,
                                                            border: '4px solid white',
                                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)',
                                                        }}
                                                    >
                                                        <PersonIcon
                                                            sx={{ fontSize: 60, color: '#9e9e9e' }}
                                                        />
                                                    </Avatar>
                                                </CardMedia>
                                                <CardContent sx={{ textAlign: 'center' }}>
                                                    <Typography
                                                        variant="h6"
                                                        gutterBottom
                                                        sx={{ color: '#c2185b' }}
                                                    >
                                                        {profile.Name}
                                                    </Typography>
                                                    <Grid
                                                        container
                                                        spacing={2}
                                                        columns={{ xs: 6, sm: 8, md: 12 }}
                                                    >
                                                        <Grid size={{ xs: 6, sm: 4, md: 6 }}>
                                                            <Button
                                                                fullWidth
                                                                variant="contained"
                                                                color="success"
                                                                disabled={loading}
                                                                onClick={() => {
                                                                    setIntrested("Yes");
                                                                    Addintrest(profile);
                                                                }}
                                                            >
                                                                Accept
                                                            </Button>
                                                        </Grid>

                                                        <Grid size={{ xs: 6, sm: 4, md: 6 }}>
                                                            <Button
                                                                fullWidth
                                                                variant="contained"
                                                                color="error"
                                                                disabled={loading}
                                                                onClick={() => {
                                                                    deleteintrest(profile);
                                                                }}
                                                            >
                                                                Decline
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </CardContent>
                                            </IntrestCard>
                                            )}
                                        

                                        {profile.Intrest =="Yes" &&(
                                        <Grid >
                                            <ProfileCard onClick={() => handleProfileClick(profile)}>
                                                <CardMedia
                                                    component="div"
                                                    sx={{
                                                        height: 200,
                                                        background:
                                                            profile.Gender === 'Female'
                                                                ? 'linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                                                                : 'linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)',
                                                        display: 'flex',
                                                        alignItems: 'center',
                                                        justifyContent: 'center',
                                                    }}
                                                >
                                                    <Avatar
                                                        src={getImageUrl(profile.Image)}
                                                        alt={profile.Name}
                                                        sx={{
                                                            width: 120,
                                                            height: 120,
                                                            border: '4px solid white',
                                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)',
                                                        }}
                                                    >
                                                        <PersonIcon
                                                            sx={{ fontSize: 60, color: '#9e9e9e' }}
                                                        />
                                                    </Avatar>
                                                </CardMedia>
                                                <CardContent sx={{ textAlign: 'center' }}>
                                                    <Typography
                                                        variant="h6"
                                                        gutterBottom
                                                        sx={{ color: '#c2185b' }}
                                                    >
                                                        {profile.Name}
                                                    </Typography>
                                                    <Box
                                                        sx={{
                                                            display: 'flex',
                                                            mt: 1,
                                                            color: 'text.secondary',
                                                            justifyContent: 'center',
                                                        }}
                                                    >
                                                        <EmailIcon
                                                            fontSize="small"
                                                            sx={{ mr: 0.5 }}
                                                        />
                                                        <Typography
                                                            variant="body2"
                                                            noWrap
                                                        >
                                                            {profile.Email || 'Not specified'}
                                                        </Typography>
                                                    </Box>
                                                </CardContent>
                                            </ProfileCard>
                                        </Grid>
                                         )}
                                    </Grid>
                                ))}
                            </Grid>
                        )}
                    </StyledPaper>
                </Container>
            </Box >
            <ProfileDetailDialog />
        </>

    );
}
