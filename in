const [currentUserMember, setCurrentUserMember] = useState(null);
const [loading, setLoading] = useState(true);

useEffect(() => {
  const fetchCurrentUserStatus = async () => {
    try {
      setLoading(true);
      const profiles = await getProfile(); // however this is called in your app

      // profiles could be an array, or getProfile might return a single object -
      // adjust this line to match your actual data shape
      const matchedProfile = Array.isArray(profiles)
        ? profiles.find(
            (p) => p.Email?.toLowerCase() === currentUserEmail?.toLowerCase()
          )
        : profiles;

      if (matchedProfile) {
        setCurrentUserMember(
          matchedProfile.Membership === 'Premium' ? 'Premium' : 'Free'
        );
      } else {
        setCurrentUserMember('Free');
      }
    } catch (err) {
      console.error('Failed to fetch user profile:', err);
      setCurrentUserMember('Free'); // safe fallback
    } finally {
      setLoading(false);
    }
  };

  if (currentUserEmail) {
    fetchCurrentUserStatus();
  }
}, [currentUserEmail]);
