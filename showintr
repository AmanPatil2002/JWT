export default function ShowInterest() {
    const [profiles, setProfiles] = useState([]);
    //const [intrest, setIntrest] = useState([]);
    const [actionLoading, setActionLoading] = useState(null);
    const currentUserEmail = localStorage.getItem("email");

    useEffect(() => {
        if (currentUserEmail) {
            fetchInterestedProfiles();
            // showIntrest();
        } else {
            setProfiles([]);

        }
    }, [currentUserEmail]);

    //  const showIntrest = async () => {
    //     try {
    //         const res = await axios.get(`${API_URL}/user/intrest`);
    //         setIntrest(res.data);
    //     } catch (err) {
    //         console.log("Error details:", err.response?.data || err.message);
    //     }
    // };

    const fetchInterestedProfiles = async () => {
        try {
            const response = await axios.get(
                `${API_URL}/user/intrest/sent/${encodeURIComponent(
                    currentUserEmail
                )}`
            );

            console.log(response.data)
            const interests = Array.isArray(response.data)
                ? response.data
                : [];
            setProfiles(interests);
        } catch (err) {
            console.error(
                "Error fetching interested profiles:",
                err.response?.data || err.message
            );
            setProfiles([]);
        }
    };

    const acceptInterest = async (profile) => {
        setActionLoading(profile.RegisterID);
        try {
            const response = await axios.put(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
                {
                    intrest: "Yes",
                    requesterEmail: currentUserEmail,
                    profileId: profile.RegisterID,
                }
            );
            console.log(response.data);
            setProfiles((prev) =>
                prev.filter(
                    (item) => item.RegisterID !== profile.RegisterID
                )
            );
        } catch (err) {
            console.error(
                "Error updating interest:",
                err.response?.data || err.message
            );
        } finally {
            setActionLoading(null);
        }
    };

    const rejectInterest = async (profile) => {
        setActionLoading(profile.RegisterID);
        try {
            const response = await axios.put(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
                {
                    intrest: "No",
                    requesterEmail: currentUserEmail,
                    profileId: profile.RegisterID,
                }
            );
            console.log(response.data);
            setProfiles((prev) =>
                prev.filter(
                    (item) => item.RegisterID !== profile.RegisterID
                )
            );
        } catch (err) {
            console.error(
                "Error updating interest:",
                err.response?.data || err.message
            );
        } finally {
            setActionLoading(null);
        }
    };


    const getImageUrl = (imagePath) => {
        if (!imagePath) return null;
        if (imagePath.startsWith('http')) return imagePath;
        const cleanPath = imagePath.replace(/^\/+/, '');
        return `${API_URL}/${cleanPath}`;
    };

    return (
        <>
            <CssBaseline />
            <Box
                sx={{
                    minHeight: { xs: '60vh', sm: '50vh', md: '50vh' },
                    background: "#e3e3e3",
                    py: { xs: 2, sm: 3, md: 4 },
                    px: { xs: 1, sm: 2, md: 0 },
                }}
            >
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>
                        <Typography
                            variant="h5"
                            fontWeight={700}
                            gutterBottom
                        >
                            Interest Request
                        </Typography>

                        {!currentUserEmail && (
                            <Alert severity="warning">
                                Please log in to view your interests.
                            </Alert>
                        )}
                        {profiles.length === 0 ? (
                            currentUserEmail && (
                                <Typography>
                                    You haven't marked interest in any profiles
                                    yet.
                                </Typography>
                            )
                        ) : (
                            <Grid container spacing={2}>
                                {profiles.map((profile) => {
                                    return (
                                        <Grid item size={{ xs: 12, sm: 6, md: 4, lg: 3 }} spacing={2}
                                            key={profile.ID}
                                        >
                                            <InterestCard elevation={2}>
                                                {profile.RequesterEmail == currentUserEmail && (
                                                    <>
                                                        <CardMedia
                                                            component="img"
                                                            src={getImageUrl(profile.Image)}
                                                            alt={profile.Name || "Profile"}
                                                            sx={{
                                                                width: "100%",
                                                                maxHeight: {
                                                                    xs: 280,
                                                                    sm: 260,
                                                                    md: 300,
                                                                },
                                                                objectFit: "cover",
                                                            }}
                                                            onError={(event) => {
