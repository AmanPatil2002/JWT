{currentUserMember === 'Premium' ? (
    <Box
        sx={{
            display: 'flex',
            flexDirection: 'column',
            gap: 1.5,
            width: '100%',
        }}
    >
        <Button
            color="success"
            component="a"
            href={
                selectedProfile.Contact
                    ? `https://wa.me/${selectedProfile.Contact.replace(/\D/g, '')}`
                    : undefined
            }
            target="_blank"
            rel="noopener noreferrer"
            disabled={!selectedProfile.Contact}
            variant="outlined"
            startIcon={<WhatsAppIcon />}
            sx={{ width: '100%', minHeight: 48, borderRadius: 2, justifyContent: 'center' }}
        >
            WhatsApp
        </Button>

        <Button
            color="primary"
            component="a"
            href={selectedProfile.Email ? `mailto:${selectedProfile.Email}` : undefined}
            disabled={!selectedProfile.Email}
            variant="outlined"
            startIcon={<EmailIcon />}
            sx={{ width: '100%', minHeight: 48, borderRadius: 2, justifyContent: 'center' }}
        >
            Email
        </Button>
    </Box>
) : (
    <Button
        onClick={() => navigate('/profile')}
        variant="contained"
        fullWidth
        sx={{ minHeight: 48, borderRadius: 2 }}
    >
        Get Premium Subscription
    </Button>
)}
