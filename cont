const handleSendInterest = async (profile) => {
    if (!hasProfile) {
        setInterestStatusMap(prev => ({ ...prev, [profile.RegisterID]: 'no-profile' }));
        return;
    }
    if (!currentUserEmail) {
        setInterestStatusMap(prev => ({ ...prev, [profile.RegisterID]: 'error' }));
        console.error("Current user email not found");
        return;
    }
    if (!profile?.RegisterID) {
        console.error("Profile RegisterID is missing:", profile);
        return;
    }

    setSendingInterestId(profile.RegisterID);
    setInterestStatusMap(prev => ({ ...prev, [profile.RegisterID]: null }));

    try {
        const res = await axios.post(`${API_URL}/user/intrest`, {
            requesterEmail: currentUserEmail,
            profileId: profile.RegisterID,
            intrest: "Intrested",
        });

        console.log("Interest sent:", res.data);
        setInterestStatusMap(prev => ({ ...prev, [profile.RegisterID]: 'success' }));

    } catch (err) {
        console.error("Error sending interest:", err);
        const status = err.response?.status === 409 ? 'already-sent' : 'error';
        setInterestStatusMap(prev => ({ ...prev, [profile.RegisterID]: status }));
    } finally {
        setSendingInterestId(null);
    }
};
