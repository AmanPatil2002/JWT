const updateInterest = (req, res) => {
    const { requesterEmail, profileId, intrest } = req.body;

    if (!requesterEmail || !profileId || !intrest) {
        return res.status(400).json({
            error: "requesterEmail, profileId and intrest are required"
        });
    }

    const updateSql = `
        UPDATE interested
        SET Intrest = ?
        WHERE RequesterEmail = ?
          AND ProfileID = ?
    `;

    db.query(
        updateSql,
        [intrest, requesterEmail, profileId],
        (err, result) => {
            if (err) {
                console.error("Error updating interest:", err);
                return res.status(500).json({
                    error: "Database error",
                    details: err.message
                });
            }

            if (result.affectedRows === 0) {
                return res.status(404).json({
                    error: "Interested record not found"
                });
            }
            if (intrest === "Yes") {

                const getReceiverSql = `
                    SELECT Email
                    FROM profile
                    WHERE RegisterID = ?
                    LIMIT 1
                `;

                db.query(
                    getReceiverSql,
                    [profileId],
                    (err, receiverRows) => {
                        if (err) {
                            console.error(
                                "Error finding receiver:",
                                err
                            );

                            return res.status(500).json({
                                error: "Failed to find receiver",
                                details: err.message
                            });
                        }

                        if (receiverRows.length === 0) {
                            return res.status(404).json({
                                error: "Receiver profile not found"
                            });
                        }

                        const receiverEmail = receiverRows[0].Email;

                        const getRequesterSql = `
                            SELECT RegisterID
                            FROM profile
                            WHERE Email = ?
                            LIMIT 1
                        `;

                        db.query(
                            getRequesterSql,
                            [requesterEmail],
                            (err, requesterRows) => {
                                if (err) {
                                    console.error(
                                        "Error finding requester:",
                                        err
                                    );

                                    return res.status(500).json({
                                        error: "Failed to find requester",
                                        details: err.message
                                    });
                                }

                                if (requesterRows.length === 0) {
                                    return res.status(404).json({
                                        error: "Requester profile not found"
                                    });
                                }

                                const requesterProfileId =
                                    requesterRows[0].RegisterID;

                                const checkReciprocalSql = `
                                    SELECT ID
                                    FROM interested
                                    WHERE RequesterEmail = ?
                                      AND ProfileID = ?
                                    LIMIT 1
                                `;

                                db.query(
                                    checkReciprocalSql,
                                    [
                                        receiverEmail,
                                        requesterProfileId
                                    ],
                                    (err, existingRows) => {
                                        if (err) {
                                            console.error(
                                                "Error checking reciprocal interest:",
                                                err
                                            );

                                            return res.status(500).json({
                                                error: "Database error",
                                                details: err.message
                                            });
                                        }

                                        if (existingRows.length > 0) {
                                    
                                            const updateReciprocalSql = `
                                                UPDATE interested
                                                SET Intrest = 'Yes'
                                                WHERE RequesterEmail = ?
                                                  AND ProfileID = ?
                                            `;

                                            db.query(
                                                updateReciprocalSql,
                                                [
                                                    receiverEmail,
                                                    requesterProfileId
                                                ],
                                                (err) => {
                                                    if (err) {
                                                        console.error(
                                                            "Error updating reciprocal:",
                                                            err
                                                        );

                                                        return res.status(500).json({
                                                            error: "Failed to update reciprocal interest",
                                                            details: err.message
                                                        });
                                                    }

                                                    return res.status(200).json({
                                                        message:
                                                            "Interest accepted successfully",
                                                        requesterEmail,
                                                        receiverEmail,
                                                        profileId,
                                                        intrest: "Yes"
                                                    });
                                                }
                                            );

                                            return;
                                        }

                                        
                                        const insertReciprocalSql = `
                                            INSERT INTO interested
                                            (RequesterEmail, ProfileID, Intrest)
                                            VALUES (?, ?, 'Yes')
                                        `;

                                        db.query(
                                            insertReciprocalSql,
                                            [
                                                receiverEmail,
                                                requesterProfileId
                                            ],
                                            (err) => {
                                                if (err) {
                                                    console.error(
                                                        "Error creating reciprocal interest:",
                                                        err
                                                    );

                                                    return res.status(500).json({
                                                        error: "Failed to create reciprocal interest",
                                                        details: err.message
                                                    });
                                                }

                                                return res.status(200).json({
                                                    message:
                                                        "Interest accepted successfully",
                                                    requesterEmail,
                                                    receiverEmail,
                                                    profileId,
                                                    intrest: "Yes"
                                                });
                                            }
                                        );
                                    }
                                );
                            }
                        );
                    }
                );

                return;
            }

            return res.status(200).json({
                message: "Interest updated successfully",
                requesterEmail,
                profileId,
                intrest
            });
        }
    );
};









