import {
    Box,
    Container,
    CssBaseline,
    Grid,
    Paper,
    Typography,
    Divider,
    Card,
    CardContent,
    CardMedia,
    Avatar,
    Chip,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    Skeleton,
    IconButton,
} from "@mui/material";
import { styled } from "@mui/material/styles";
import PersonIcon from '@mui/icons-material/Person';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import SchoolIcon from '@mui/icons-material/School';
import CallIcon from '@mui/icons-material/Call';
import EmailIcon from '@mui/icons-material/Email';
import AccessibleIcon from '@mui/icons-material/Accessible';
import AccessibilityIcon from '@mui/icons-material/Accessibility';
import FavoriteIcon from '@mui/icons-material/Favorite';
import HeightIcon from '@mui/icons-material/Height';
import WhatsAppIcon from '@mui/icons-material/WhatsApp';
import InfoIcon from '@mui/icons-material/Info';
import CalendarMonthIcon from '@mui/icons-material/CalendarMonth';
import { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";

import axios from "axios";

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000';

const StyledPaper = styled(Paper)(({ theme }) => ({
    padding: theme.spacing(3),
    borderRadius: 16,
    boxShadow: '0 8px 32px rgba(0,0,0,0.1)',
    [theme.breakpoints.down('sm')]: {
        padding: theme.spacing(2),
        borderRadius: 12,
    },
}));

const ProfileCard = styled(Card)(() => ({
    height: '100%',
    transition: 'transform 0.3s, box-shadow 0.3s',
    cursor: 'pointer',
    position: 'relative',
    overflow: 'visible',
    '&:hover': {
        transform: 'translateY(-8px)',
        boxShadow: '0 12px 40px rgba(0,0,0,0.15)',
    },
}));


export default function Match() {
    const navigate = useNavigate();
    const [profiles, setProfiles] = useState([]);
    const [filteredProfiles, setFilteredProfiles] = useState([]);
    const [loading, setLoading] = useState(true);
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [detailOpen, setDetailOpen] = useState(false);

    const currentUserEmail = localStorage.getItem('email');

    useEffect(() => {
        if (currentUserEmail) {
            fetchInterestedProfiles();
        } else {
            setProfiles([]);
            setFilteredProfiles([]);
        }
    }, [currentUserEmail]);

    const fetchInterestedProfiles = async () => {
        setLoading(true);

        try {
            const res = await axios.get(
                `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`
            );

            console.log("Fetched interests:", res.data);

            const interests = Array.isArray(res.data)
                ? res.data
                : [];

            setProfiles(interests);
            setFilteredProfiles(interests);

        } catch (err) {
            console.error(
                "Error fetching interested profiles:",
                err.response?.data || err.message
            );

            setProfiles([]);
            setFilteredProfiles([]);
        } finally {
            setLoading(false);
        }
    };

    const handleProfileClick = (profile) => {
        setSelectedProfile(profile);
        setDetailOpen(true);
    };


    const getImageUrl = (imagePath) => {
        if (!imagePath) return null;
        if (imagePath.startsWith('http')) return imagePath;
        const cleanPath = imagePath.replace(/^\/+/, '');
        return `${API_URL}/${cleanPath}`;
    };

    const ProfileDetailDialog = () => (
        <Dialog
            open={detailOpen}
            onClose={() => setDetailOpen(false)}
            maxWidth="80%"
            fullWidth
        >
            {selectedProfile && (

                <>
                    <DialogTitle sx={{
                        display: 'flex',
                        justifyContent: 'space-between',
                        alignItems: 'center',
                        background: selectedProfile.Gender === 'Female'
                            ? 'linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                            : 'linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)',
                        color: 'white'
                    }}>
                        <Typography variant="h5" fontWeight="bold" sx={{ textAlign: 'center' }}>
                            {selectedProfile.Name}'s Profile
                        </Typography>
                    </DialogTitle>
                    <DialogContent dividers sx={{ p: 3 }}>
                        <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 8, md: 12 }}>
                            <Grid size={{ xs: 2, sm: 4, md: 4 }}>
                                <Box textAlign="center">
                                    <Avatar
                                        src={getImageUrl(selectedProfile.Image)}
                                        alt={selectedProfile.Name}
                                        sx={{
                                            width: 300,
                                            height: 400,
                                            mx: 'auto',
                                            mb: 2,
                                            borderRadius: 2,
                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                        }}
                                        variant="rounded"
                                    >
                                        <PersonIcon sx={{ fontSize: 100 }} />
                                    </Avatar>
                                    <Typography variant="h6" gutterBottom sx={{ textAlign: 'center' }}>
                                        {selectedProfile.Name}
                                    </Typography>

                                </Box>
                            </Grid>
                            <Grid size={{ xs: 2, sm: 8, md: 8 }}>
                                <Typography variant="h6" gutterBottom sx={{
                                    display: 'flex',
                                    alignItems: 'center',
                                    gap: 1,
                                    color: '#c2185b'
                                }}>
                                    <InfoIcon /> Personal Information
                                </Typography>
                                <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 10, md: 12 }}>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Gender : </b>{selectedProfile.Gender || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Religion : </b>{selectedProfile.Religion || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Mother Tongue : </b>{selectedProfile.Language || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Marital Status : </b><Chip label={selectedProfile.Status || 'Not specified'} size="small" />
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <LocationOnIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {selectedProfile.Address || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <CalendarMonthIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {selectedProfile.DOB ? new Date(selectedProfile.DOB).toLocaleString("en-IN", {
                                                day: "2-digit",
                                                month: "long",
                                                year: "numeric",
                                            }) : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <HeightIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {`${selectedProfile.Height} ft`}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 2, sm: 4, md: 3 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <AccessibilityIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {`${selectedProfile.Age} years`}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Divider sx={{ my: 2 }} />

                                <Typography variant="h6" gutterBottom sx={{
                                    display: 'flex',
                                    alignItems: 'center',
                                    gap: 1,
                                    color: '#c2185b'
                                }}>
                                    <SchoolIcon /> Education & Career
                                </Typography>
                                <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 8, md: 12 }}>
                                    <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Education : </b>{selectedProfile.Education || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Occupation : </b>{selectedProfile.Occupation || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Company : </b>{selectedProfile.CompanyName || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                        <Typography variant="body2" color="text.secondary">
                                            <b>Monthly Income : </b>{selectedProfile.MonthlyIncome ? `₹${parseInt(selectedProfile.MonthlyIncome).toLocaleString()}` : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 8, md: 12 }}>

                                    {selectedProfile.Detail && (
                                        <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                            <Divider sx={{ my: 2 }} />
                                            <Typography variant="h6" gutterBottom sx={{
                                                display: 'flex',
                                                alignItems: 'center',
                                                gap: 1,
                                                color: '#c2185b'
                                            }}>
                                                <FavoriteIcon /> About Me
                                            </Typography>
                                            <Paper sx={{ p: 2, bgcolor: '#fdf2f8', borderRadius: 2 }}>
                                                <Typography variant="body1" sx={{ whiteSpace: 'pre-line', lineHeight: 1.8 }}>
                                                    {selectedProfile.Detail}
                                                </Typography>
                                            </Paper>
                                        </Grid>
                                    )}

                                    <Grid size={{ xs: 6, sm: 6, md: 6 }}>
                                        <Divider sx={{ my: 2 }} />
                                        <Typography variant="h6" gutterBottom sx={{
                                            display: 'flex',
                                            alignItems: 'center',
                                            gap: 1,
                                            color: '#c2185b'
                                        }}>
                                            Contact
                                        </Typography>
                                        {selectedProfile.Member === "Premium" ? (
                                            <Box sx={{ display: "flex", flexDirection: "column", gap: 1.5 }}>
                                                <IconButton
                                                    color="success"
                                                    component="a"
                                                    href={`https://wa.me/${selectedProfile.Contact}`}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    sx={{
                                                        border: "1px solid",
                                                        borderColor: "success.main",
                                                        borderRadius: 2,
                                                        width: 400,
                                                        height: 48
                                                    }}
                                                >
                                                    <WhatsAppIcon />
                                                </IconButton>

                                                <IconButton
                                                    color="primary"
                                                    component="a"
                                                    href={`mailto:${selectedProfile.Email}`}
                                                    sx={{
                                                        border: "1px solid",
                                                        borderColor: "primary.main",
                                                        borderRadius: 2,
                                                        width: 400,
                                                        height: 48
                                                    }}
                                                >
                                                    <EmailIcon />
                                                </IconButton>
                                                
                                            </Box>
                                        ) : (
                                            <Box>
                                                <Button onClick={() => navigate("/profile")} variant="contained">
                                                <Typography variant="body1" sx={{ lineHeight: 1.8 , color:"White"}}>
                                                    Get Premium Subscription
                                                </Typography>
                                                </Button>
                                            </Box>
                                        )}
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DialogContent>
                    <DialogActions>
                        <Button onClick={() => setDetailOpen(false)} variant="outlined">Close</Button>
                    </DialogActions>
                </>
            )}
        </Dialog>
    );

    const ProfileCardSkeleton = () => (
        <Grid item xs={12} sm={6} md={4} lg={3}>
            <Card>
                <Skeleton variant="rectangular" height={200} />
                <CardContent>
                    <Skeleton variant="text" width="60%" height={30} />
                    <Skeleton variant="text" width="40%" />
                    <Skeleton variant="text" width="80%" />
                </CardContent>
            </Card>
        </Grid>
    );

    return (
        <>
            <CssBaseline />
            <Box sx={{
                minHeight: '100vh',
                background: 'linear-gradient(135deg, rgb(163, 65, 65) 0%,rgb(232, 53, 37) 100%)',
                py: { xs: 2, sm: 3, md: 4 },
                px: { xs: 1, sm: 2, md: 0 },
            }}>
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>
                        <Box textAlign="center" mb={4}>
                            <Typography variant="h4" fontWeight="bold" sx={{ color: '#c2185b', textAlign: 'center' }}>
                                Intrested Profiles
                            </Typography>
                        </Box>

                        <Divider sx={{ mb: 3 }} />

                        {loading ? (
                            <Grid container spacing={3}>
                                {[...Array(8)].map((_, index) => (
                                    <ProfileCardSkeleton key={index} />
                                ))}
                            </Grid>
                        ) : filteredProfiles.length === 0 ? (
                            <Box textAlign="center" py={8}>
                                <PersonIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    No Profiles Found
                                </Typography>

                            </Box>
                        ) : (
                            <Grid container spacing={{ xs: 2, md: 3 }} columns={{ xs: 4, sm: 8, md: 12 }}>
                                {filteredProfiles.map((profile) => (
                                    <Grid size={{ xs: 2, sm: 2, md: 3 }} key={profile.RegisterID}>
                                        <ProfileCard onClick={() => handleProfileClick(profile)}>
                                            <CardMedia
                                                component="div"
                                                sx={{
                                                    height: 200,
                                                    background: profile.Gender === 'Female'
                                                        ? 'linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)'
                                                        : 'linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)',
                                                    display: 'flex',
                                                    alignItems: 'center',
                                                    justifyContent: 'center',
                                                }}
                                            >
                                                <Avatar
                                                    src={getImageUrl(profile.Image)}
                                                    alt={profile.Name}
                                                    sx={{
                                                        width: 120,
                                                        height: 120,
                                                        border: '4px solid white',
                                                        boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                                    }}
                                                >
                                                    <PersonIcon sx={{ fontSize: 60, color: '#9e9e9e' }} />
                                                </Avatar>
                                            </CardMedia>
                                            <CardContent sx={{ textAlign: 'center' }}>
                                                <Typography variant="h6" gutterBottom sx={{ color: '#c2185b' }}>
                                                    {profile.Name}
                                                </Typography>
                                                <Box sx={{ mb: 1 }}>
                                                    <Chip
                                                        label={`${profile.Age} yrs`}
                                                        size="small"
                                                        color="black"
                                                        sx={{ mr: 1, mb: 1 }}
                                                    />

                                                    {profile.Status == "Single"
                                                        ? (
                                                            <Chip label={profile.Status} size="small"
                                                                variant="outlined"
                                                                sx={{ mr: 1, mb: 1, color: '#66BB6A', }} />
                                                        ) : (
                                                            <Chip label={profile.Status} size="small"
                                                                variant="outlined"
                                                                color="primary"
                                                                sx={{ mr: 1, mb: 1, color: '#2c73d2', }} />
                                                        )}
                                                </Box>
                                                <div>
                                                    <Box sx={{ display: 'flex', mt: 1, color: 'text.secondary', justifyContent: 'center' }}>
                                                        <EmailIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                        <Typography variant="body2" noWrap>
                                                            {profile.Email || 'Not specified'}
                                                        </Typography>
                                                    </Box>

                                                    <Box>
                                                        {profile.Physically === 'Yes' ? (
                                                            <>
                                                                <Typography variant="body2" color='warning' >
                                                                    <AccessibleIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                                                    Physically Challenged
                                                                </Typography>
                                                            </>
                                                        ) : (
                                                            <Typography variant="body2" color='success'>
                                                                <AccessibilityIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                                                Not Physically Challenged
                                                            </Typography>
                                                        )}
                                                    </Box>
                                                </div>

                                            </CardContent>
                                        </ProfileCard>
                                    </Grid>
                                ))}
                            </Grid>
                        )}
                    </StyledPaper>
                </Container>
            </Box>
            <ProfileDetailDialog />
        </>
    );
}
