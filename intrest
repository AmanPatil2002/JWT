const currentUserEmail = localStorage.getItem('email');
const [currentUserMember, setCurrentUserMember] = useState(localStorage.getItem('member') || null);

useEffect(() => {
    if (currentUserEmail) {
        fetchInterestedProfiles();
        fetchCurrentUser();
    } else {
        setProfiles([]);
        setFilteredProfiles([]);
        setLoading(false);
    }
}, [currentUserEmail]);

const fetchCurrentUser = async () => {
    try {
        const res = await axios.get(`${API_URL}/user/${encodeURIComponent(currentUserEmail)}`);
        setCurrentUserMember(res.data?.Member || null);
    } catch (err) {
        console.error("Error fetching current user:", err.response?.data || err.message);
    }
};















