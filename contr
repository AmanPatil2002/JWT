const getYesInterested = (req, res) => {
    const { email } = req.params;

    const sql = `
        SELECT
            p.*,
            MAX(i.CreatedAt) AS CreatedAt
        FROM interested i
        INNER JOIN profile me ON me.Email = ?
        INNER JOIN profile p ON (
            (i.RequesterEmail = ? AND p.RegisterID = i.ProfileID)
            OR
            (i.ProfileID = me.RegisterID AND p.Email = i.RequesterEmail)
        )
        WHERE i.Intrest = 'Yes'
        GROUP BY p.RegisterID
        ORDER BY CreatedAt DESC
    `;

    db.query(sql, [email, email], (err, results) => {
        if (err) {
            console.error("Error fetching Yes interests:", err);
            return res.status(500).json({
                error: "Database error",
                details: err.message
            });
        }
        res.status(200).json(results);
    });
};
