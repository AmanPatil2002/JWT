                                },
                            }}
                        >
                            Close
                        </Button>
                    </DialogActions>
                </>
            )}
        </Dialog>
    );
};


const ProfileCardSkeleton = () => (
    <Grid size={{ xs: 12, sm: 6, md: 4, lg: 3 }}>
        <Card>
            <Skeleton variant="rectangular" height={200} />

            <CardContent>
                <Skeleton
                    variant="text"
                    width="60%"
                    height={30}
                />

                <Skeleton
                    variant="text"
                    width="40%"
                />

                <Skeleton
                    variant="text"
                    width="80%"
                />
            </CardContent>
        </Card>
    </Grid>
);


export default function Intrest() {
    const navigate = useNavigate();
    const [profiles, setProfiles] = useState([]);
    const [filteredProfiles, setFilteredProfiles] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(false);
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [detailOpen, setDetailOpen] = useState(false);

    const [isPremium, setIsPremium] = useState(false);
    const [checkingMembership, setCheckingMembership] = useState(true);
    const [message, setMessage] = useState([]);
    const [messageText, setMessageText] = useState("");
    const [sending, setSending] = useState(false);

    const currentUserEmail = localStorage.getItem("email");

    const [open, setOpen] = useState(false);


    const handleClickOpen = () => {
        setMessageText("");
        setOpen(true);
    };


    const handleClose = () => {
        setOpen(false);
        setMessageText("");
    };

    useEffect(() => {
        if (!currentUserEmail) {
            setProfiles([]);
            setFilteredProfiles([]);
            setLoading(false);
            setCheckingMembership(false);
            return;
        }

        fetchMessage();
        checkMembership();
    }, [currentUserEmail]);


    const checkMembership = async () => {
        if (!currentUserEmail) {
            setIsPremium(false);
            setCheckingMembership(false);
            setLoading(false);
            return;
        }

        setCheckingMembership(true);
        setError(false);

        try {
            const res = await axios.get(
                `${API_URL}/profile/profile`
            );

            const allProfiles = Array.isArray(res.data)
                ? res.data
                : res.data?.profiles || [];

            const currentUser = allProfiles.find(
                (user) =>
                    user.Email?.toLowerCase() ===
                    currentUserEmail.toLowerCase()
            );

            if (!currentUser) {
                console.warn(
                    "Current user profile not found"
                );

                setIsPremium(false);
                setProfiles([]);
                setFilteredProfiles([]);

                return;
            }

            const premium =
                String(currentUser.Member || "")
                    .trim()
                    .toLowerCase() === "premium";

            setIsPremium(premium);

            if (premium) {
                await fetchInterestedProfiles();
            } else {
                setProfiles([]);
                setFilteredProfiles([]);
                setLoading(false);
            }
        } catch (err) {
            console.error(
                "Error checking membership:",
                err.response?.data || err.message
            );

            setIsPremium(false);
            setProfiles([]);
            setFilteredProfiles([]);
            setError(true);
            setLoading(false);
        } finally {
            setCheckingMembership(false);
        }
    };

    const fetchInterestedProfiles = async () => {
        setLoading(true);
        setError(false);

        try {
            const res = await axios.get(
                `${API_URL}/user/status/Yes/${encodeURIComponent(
                    currentUserEmail
                )}`
            );

            const interests = Array.isArray(res.data)
                ? res.data
                : [];

            setProfiles(interests);
            setFilteredProfiles(interests);
        } catch (err) {
            console.error(
                "Error fetching interested profiles:",
                err.response?.data || err.message
            );

            setProfiles([]);
            setFilteredProfiles([]);
            setError(true);
        } finally {
            setLoading(false);
        }
    };

    const handleProfileClick = (profile) => {
        setSelectedProfile(profile);
        setDetailOpen(true);
    };

    const fetchMessage = async () => {
        if (!currentUserEmail) {
            return;
        }

        try {
            const res = await axios.get(
                `${API_URL}/send/message/${encodeURIComponent(
                    currentUserEmail
                )}`
            );

            setMessage(
                Array.isArray(res.data)
                    ? res.data
                    : []
            );
        } catch (err) {
            console.error(
                "Error fetching messages:",
                err.response?.data || err.message
            );

            setMessage([]);
        }
    };

    const handleSendMessage = async () => {
        const trimmed = messageText.trim();

        if (
            !trimmed ||
            !selectedProfile ||
            !currentUserEmail ||
            sending
        ) {
            return;
        }

        setSending(true);

        try {
            const res = await axios.post(
                `${API_URL}/send/message/${encodeURIComponent(
                    currentUserEmail
                )}`,
                {
                    receiverId: selectedProfile.RegisterID,
                    message: trimmed,
                }
            );

            console.log(res.data);
            setMessageText("");
            await fetchMessage();
        } catch (err) {
            console.error(
                "Error sending message:",
                err.response?.data || err.message
            );
        } finally {
            setSending(false);
        }
    };

    const getImageUrl = (imagePath) => {
        if (!imagePath) {
            return null;
        }

        if (imagePath.startsWith("http")) {
            return imagePath;
        }

        const cleanPath =
            imagePath.replace(/^\/+/, "");

        return `${API_URL}/${cleanPath}`;
    };

    return (
        <>
            <CssBaseline />

            <Box
                sx={{
                    minHeight: "100vh",

                    background:
                        "linear-gradient(135deg, rgb(163, 65, 65) 0%,rgb(232, 53, 37) 100%)",

                    py: {
                        xs: 2,
                        sm: 3,
                        md: 4,
                    },

                    px: {
                        xs: 1,
                        sm: 2,
                        md: 0,
                    },
                }}
            >
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>

                        <Box
                            textAlign="center"
                            mb={4}
                        >
                            <Typography
                                variant="h4"
                                fontWeight="bold"
                                sx={{
                                    color: "#c2185b",
                                    textAlign: "center",
                                }}
                            >
                                Interested Profiles
                            </Typography>
                        </Box>

                        <Divider sx={{ mb: 3 }} />

                        {checkingMembership ? (
                            <Box
                                textAlign="center"
                                py={8}
                            >
                                <Skeleton
                                    variant="rectangular"
                                    width={220}
                                    height={50}
                                    sx={{
                                        mx: "auto",
                                        borderRadius: 2,
                                    }}
                                />

                                <Skeleton
                                    variant="text"
                                    width={300}
                                    sx={{
                                        mx: "auto",
                                        mt: 2,
                                    }}
                                />
                            </Box>
                        ) : !isPremium ? (
                            <Box
                                py={8}
                                sx={{
                                    maxWidth: 600,
                                    mx: "auto",
                                    textAlign: "center",
                                }}
                            >
                                <Typography
                                    variant="h5"
                                    fontWeight="bold"
                                    gutterBottom
                                    sx={{
                                        color: "#c2185b",
                                    }}
                                >
                                    Premium Membership Required
                                </Typography>

                                <Typography
                                    variant="body1"
                                    color="text.secondary"
                                    sx={{ mb: 3 }}
                                >
                                    Upgrade to Premium to see
                                    profiles that are interested
                                    in you.
                                </Typography>

                                <Button
                                    variant="contained"
                                    size="large"
                                    startIcon={
                                        <FavoriteIcon />
                                    }
                                    onClick={() =>
                                        navigate("/profile")
                                    }
                                    sx={{
                                        px: 5,
                                        py: 1.5,
                                        borderRadius: 3,

                                        background:
                                            "linear-gradient(135deg, #c2185b 0%, #e91e63 100%)",

                                        "&:hover": {
                                            background:
                                                "linear-gradient(135deg, #ad1457 0%, #c2185b 100%)",
                                        },
                                    }}
                                >
                                    Get Premium
                                </Button>
                            </Box>
                        ) : loading ? (
                            <Grid container spacing={3}>
                                {[...Array(8)].map(
                                    (_, index) => (
                                        <ProfileCardSkeleton
                                            key={index}
                                        />
                                    )
                                )}
                            </Grid>
                        ) : error ? (
                            <Box
                                textAlign="center"
                                py={8}
                            >
                                <PersonIcon
                                    sx={{
                                        fontSize: 80,
                                        color: "text.secondary",
                                        mb: 2,
                                    }}
                                />

                                <Typography
                                    variant="h5"
                                    color="text.secondary"
                                    gutterBottom
                                >
                                    Couldn't load your
                                    interested profiles
                                </Typography>

                                <Typography
                                    variant="body2"
                                    color="text.secondary"
                                    gutterBottom
                                >
                                    Something went wrong.
                                    Please try again.
                                </Typography>

                                <Button
                                    variant="outlined"
                                    onClick={
                                        fetchInterestedProfiles
                                    }
                                    sx={{ mt: 2 }}
                                >
                                    Retry
                                </Button>
                            </Box>
                        ) : filteredProfiles.length === 0 ? (
                            <Box
                                textAlign="center"
                                py={8}
                            >
                                <PersonIcon
                                    sx={{
                                        fontSize: 80,
                                        color: "text.secondary",
                                        mb: 2,
                                    }}
                                />

                                <Typography
                                    variant="h5"
                                    color="text.secondary"
                                    gutterBottom
                                >
                                    No Profiles Found
                                </Typography>
                            </Box>
                        ) : (


                            <Grid
                                container
                                spacing={{
                                    xs: 2,
                                    md: 3,
                                }}
                                columns={{
                                    xs: 4,
                                    sm: 8,
                                    md: 12,
                                }}
                            >
                                {filteredProfiles.map(
                                    (profile) => (
                                        <Grid
                                            size={{
                                                xs: 2,
                                                sm: 2,
                                                md: 3,
                                            }}
                                            key={
                                                profile.RegisterID
                                            }
                                        >
                                            <ProfileCard
                                                onClick={() =>
                                                    handleProfileClick(
                                                        profile
                                                    )
                                                }
                                            >
                                                <CardMedia
                                                    component="div"
                                                    sx={{
                                                        height: 200,

                                                        background:
                                                            profile.Gender ===
                                                                "Female"
                                                                ? "linear-gradient(135deg,rgb(245, 118, 160) 0%, #f8bbd0 100%)"
                                                                : "linear-gradient(135deg,rgb(29, 156, 248) 0%, #bbdefb 100%)",

                                                        display:
                                                            "flex",

                                                        alignItems:
                                                            "center",

                                                        justifyContent:
                                                            "center",
                                                    }}
                                                >
                                                    <Avatar
                                                        src={getImageUrl(
                                                            profile.Image
                                                        )}
                                                        alt={
                                                            profile.Name
                                                        }
                                                        sx={{
                                                            width: 120,
                                                            height: 120,

                                                            border:
                                                                "4px solid white",

                                                            boxShadow:
                                                                "0 4px 12px rgba(0,0,0,0.1)",
                                                        }}
                                                    >
                                                        <PersonIcon
                                                            sx={{
                                                                fontSize: 60,
                                                                color: "#9e9e9e",
                                                            }}
                                                        />
                                                    </Avatar>
                                                </CardMedia>

                                                <CardContent
                                                    sx={{
                                                        textAlign:
                                                            "center",
                                                    }}
                                                >
                                                    <Typography
                                                        variant="h6"
                                                        gutterBottom
                                                        sx={{
                                                            color: "#c2185b",
                                                        }}
                                                    >
                                                        {
                                                            profile.Name
                                                        }
                                                    </Typography>

                                                    <Box
                                                        sx={{
                                                            display:
                                                                "flex",

                                                            mt: 1,

                                                            color: "text.secondary",

                                                            justifyContent:
                                                                "center",
                                                        }}
                                                    >
                                                        <EmailIcon
                                                            fontSize="small"
                                                            sx={{
                                                                mr: 0.5,
                                                            }}
                                                        />

                                                        <Typography
                                                            variant="body2"
                                                            noWrap
                                                        >
                                                            {profile.Email ||
                                                                "Not specified"}
                                                        </Typography>
                                                    </Box>
                                                </CardContent>
                                            </ProfileCard>
                                        </Grid>
                                    )
                                )}
                            </Grid>
                        )}
                    </StyledPaper>
                </Container>
            </Box>


            <ProfileDetailDialog
                detailOpen={detailOpen}
                setDetailOpen={setDetailOpen}
                selectedProfile={selectedProfile}
                open={open}
                handleClickOpen={handleClickOpen}
                handleClose={handleClose}
                messageText={messageText}
                setMessageText={setMessageText}
                handleSendMessage={handleSendMessage}
                sending={sending}
                getImageUrl={getImageUrl}
            />
        </>
    );
}
