import Paper from '@mui/material/Paper';
import { useState, useEffect } from "react";
import axios from "axios";
import {
    Box,
    Typography,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Grid,
    Button,
    TextField,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    Chip,
} from "@mui/material";
import EditIcon from '@mui/icons-material/Edit';
import AddBoxIcon from '@mui/icons-material/AddBox';
import ArrowForwardIcon from '@mui/icons-material/ArrowForward';
import PsychologyAltIcon from '@mui/icons-material/PsychologyAlt';

const API_URL = import.meta.env.VITE_API_URL;

export default function QueryTable() {
    const [queries, setQueries] = useState([]);
    const [openDialog, setOpenDialog] = useState(false);
    const [selectedQuery, setSelectedQuery] = useState(null);
    const [solution, setSolution] = useState("");
    const [loading, setLoading] = useState(false);

    useEffect(() => {
        fetchQueries();
    }, []);

    const fetchQueries = async () => {
        try {
            const res = await axios.get(`${API_URL}/api/query`);
            console.log("API Response:", res.data);
            setQueries(res.data);
        } catch (err) {
            console.log("Error details:", err.response?.data || err.message);
        }
    };

    const handleOpenDialog = (query) => {
        setSelectedQuery(query);
        setSolution(query.Solution || "");
    };

    const handleCloseDialog = () => {
        setOpenDialog(false);
        setSelectedQuery(null);
        setSolution("");
    };

    const handleSubmitSolution = async () => {
        if (!solution.trim()) {
            return;
        }

        setLoading(true);
        try {
            const res = await axios.put(`${API_URL}/api/query/${selectedQuery.QueryID}`, {
                solution: solution
            });
            console.log("API Response:", res.data);
            handleCloseDialog();
            fetchQueries();
        } catch (err) {
            console.log("Error:", err.response?.data || err.message);
        } finally {
            setLoading(false);
        }
    };

    return (
        <Box className="p-6">

            <Paper elevation={3} className="overflow-hidden rounded-lg">
                <TableContainer className="max-h-[600px]">
                    <Table stickyHeader>
                        <TableHead>
                            <TableRow>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "20%" }}
                                >
                                    User Details
                                </TableCell>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "40%" }}
                                >
                                    Query & Solution
                                </TableCell>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "15%" }}
                                >
                                    Action
                                </TableCell>
                            </TableRow>
                        </TableHead>
                        <TableBody>
                            {queries.map((query) => (
                                <TableRow
                                    key={query.QueryID}
                                    className="hover:bg-gray-50 transition-colors"
                                    sx={{
                                        bgcolor: !query.Solution ? "error" : "inherit"
                                    }}
                                >
                                    <TableCell align="left" className="py-4">
                                        <Grid container rowSpacing={1} columnSpacing={{ xs: 1, sm: 2, md: 3 }}>
                                            <Grid size={12}>
                                                <Typography variant="body2">
                                                    <b>Name:</b> {query.Name}
                                                </Typography>
                                            </Grid>
                                            <Grid size={12}>
                                                <Typography variant="body2" color="text.secondary">
                                                    <b>Email:</b> {query.Email}
                                                </Typography>
                                            </Grid>
                                        </Grid>
                                    </TableCell>
                                    <TableCell align="left" className="py-4">
                                        <Grid container rowSpacing={1} columnSpacing={{ xs: 1, sm: 2, md: 3 }}>
                                            <Grid size={12}>
                                                <Typography variant="body2">
                                                    <PsychologyAltIcon/> {query.Query}
                                                </Typography>
                                            </Grid>
                                            <Grid size={12}>
                                                {query.Solution ? (
                                                    <Box sx={{ p: 1, borderRadius: 1 }}>
                                                        <Typography variant="body2" color="success.dark">
                                                           <ArrowForwardIcon/> {query.Solution}
                                                        </Typography>
                                                    </Box>
                                                ) : (
                                                    <Chip
                                                        label="Pending"
                                                        color="warning"
                                                        size="small"
                                                        variant="outlined"
                                                    />
                                                )}
                                            </Grid>
                                        </Grid>
                                    </TableCell>
                                    <TableCell align="center" className="py-4">
                                        <Button
                                            variant="contained"
                                            size="small"
                                            startIcon={query.Solution ? <EditIcon /> : <AddBoxIcon /> }
                                            onClick={() => handleOpenDialog(query)}
                                            color={query.Solution ? "primary" : "success"}
                                        >
                                            {query.Solution ? "Edit Solution" : "Add Solution"}
                                        </Button>
                                    </TableCell>
                                </TableRow>
                            ))}
                        </TableBody>
                    </Table>
                </TableContainer>
            </Paper>

            <Dialog
                open={Boolean(selectedQuery)}
                onClose={handleCloseDialog}
                maxWidth="md"
                fullWidth
            >
                {selectedQuery && (
                    <>
                        <DialogTitle>
                            <Typography variant="h6" fontWeight="bold">
                                {selectedQuery.Solution ? "Edit Solution" : "Add Solution"}
                            </Typography>
                        </DialogTitle>
                        <DialogContent>
                            <Box sx={{ mt: 2 }}>
                                <Paper sx={{ p: 2, mb: 3, bgcolor: "grey.50" }}>
                                    <Grid container spacing={2}>
                                        <Grid item xs={12}>
                                            <Typography variant="body2">
                                                <b>Query :</b> {selectedQuery.Query}
                                            </Typography>
                                        </Grid>
                                    </Grid>
                                </Paper>
                                <TextField
                                    fullWidth
                                    label="Your Solution"
                                    multiline
                                    rows={4}
                                    value={solution}
                                    onChange={(e) => setSolution(e.target.value)}
                                    placeholder="Type your solution here..."
                                    variant="outlined"
                                    required
                                />
                            </Box>
                        </DialogContent>
                        <DialogActions sx={{ p: 2 }}>
                            <Button onClick={handleCloseDialog} color="inherit">
                                Cancel
                            </Button>
                            <Button
                                onClick={handleSubmitSolution}
                                variant="contained"
                                disabled={loading || !solution.trim()}
                                color="primary"
                            >
                                {loading ? "Saving..." : "Save Solution"}
                            </Button>
                        </DialogActions>
                    </>
                )}
            </Dialog>
        </Box>
    );
}






