-- Messages table: full chat/inbox with conversation history
-- A "conversation" is derived from the (sender, receiver) pair — no separate
-- conversations table needed since the app already keys users by Email.

CREATE TABLE IF NOT EXISTS messages (
    MessageID     INT AUTO_INCREMENT PRIMARY KEY,
    SenderEmail   VARCHAR(255) NOT NULL,
    ReceiverEmail VARCHAR(255) NOT NULL,
    MessageText   TEXT NOT NULL,
    IsRead        TINYINT(1) NOT NULL DEFAULT 0,
    CreatedAt     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_messages_sender
        FOREIGN KEY (SenderEmail) REFERENCES register(Email)
        ON DELETE CASCADE,
    CONSTRAINT fk_messages_receiver
        FOREIGN KEY (ReceiverEmail) REFERENCES register(Email)
        ON DELETE CASCADE,

    INDEX idx_conversation (SenderEmail, ReceiverEmail, CreatedAt),
    INDEX idx_inbox (ReceiverEmail, IsRead)
);

-- NOTE: change `register(Email)` above to match your actual users table
-- name/PK if it differs. If Email isn't a unique/primary key on that table,
-- drop the two FOREIGN KEY constraints (indexes alone are fine).
