const [sentProfiles, setSentProfiles] = useState([]);      // "Interest Request" — waiting on response
const [receivedProfiles, setReceivedProfiles] = useState([]); // "Requested Intrests" — accept/reject
const [actionLoading, setActionLoading] = useState(null);
const currentUserEmail = localStorage.getItem("email");

useEffect(() => {
    if (currentUserEmail) {
        fetchSentInterests();
        fetchReceivedInterests();
    } else {
        setSentProfiles([]);
        setReceivedProfiles([]);
    }
}, [currentUserEmail]);

const fetchSentInterests = async () => {
    try {
        const response = await axios.get(
            `${API_URL}/user/intrest/sent/${encodeURIComponent(currentUserEmail)}`
        );
        setSentProfiles(Array.isArray(response.data) ? response.data : []);
    } catch (err) {
        console.error("Error fetching sent interests:", err.response?.data || err.message);
        setSentProfiles([]);
    }
};

const fetchReceivedInterests = async () => {
    try {
        const response = await axios.get(
            `${API_URL}/user/intrest/received/${encodeURIComponent(currentUserEmail)}`
        );
        setReceivedProfiles(Array.isArray(response.data) ? response.data : []);
    } catch (err) {
        console.error("Error fetching received interests:", err.response?.data || err.message);
        setReceivedProfiles([]);
    }
};

const acceptInterest = async (profile) => {
    setActionLoading(profile.RegisterID);
    try {
        await axios.put(
            `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
            {
                intrest: "Yes",
                requesterEmail: profile.RequesterEmail, // the original sender, not current user
                profileId: profile.ProfileID,           // current user's own RegisterID (from the row)
            }
        );
        setReceivedProfiles((prev) => prev.filter((item) => item.ID !== profile.ID));
    } catch (err) {
        console.error("Error updating interest:", err.response?.data || err.message);
    } finally {
        setActionLoading(null);
    }
};

const rejectInterest = async (profile) => {
    setActionLoading(profile.RegisterID);
    try {
        await axios.put(
            `${API_URL}/user/intrest/${encodeURIComponent(currentUserEmail)}`,
            {
                intrest: "No",
                requesterEmail: profile.RequesterEmail,
                profileId: profile.ProfileID,
            }
        );
        setReceivedProfiles((prev) => prev.filter((item) => item.ID !== profile.ID));
    } catch (err) {
        console.error("Error updating interest:", err.response?.data || err.message);
    } finally {
        setActionLoading(null);
    }
};














{/* First card: "Interest Request" — sent, waiting for response */}
{sentProfiles.map((profile) => (
    <Grid item ... key={profile.ID}>
        <InterestCard>
            <CardMedia src={getImageUrl(profile.Image)} ... />
            <CardContent>
                <Typography variant="h5">{profile.Name || "Unknown"}</Typography>
                {profile.Intrest === "Intrested" && (
                    <Typography variant="body2" sx={{ textAlign: "center", color: "gray" }}>
                        Waiting for Response
                    </Typography>
                )}
            </CardContent>
        </InterestCard>
    </Grid>
))}

{/* Second card: "Requested Intrests" — received, accept/reject */}
{receivedProfiles.map((profile) => {
    const isProcessing = actionLoading === profile.RegisterID;
    return (
        <Grid item ... key={profile.ID}>
            <InterestCard>
                <CardMedia src={getImageUrl(profile.Image)} ... />
                <CardContent>
                    <Typography variant="body1">{profile.Name || "Unknown"}</Typography>
                    <Box sx={{ display: "flex", justifyContent: "center", gap: 1, pt: 1 }}>
                        <Button onClick={() => acceptInterest(profile)} disabled={isProcessing}>
                            {isProcessing ? "Processing..." : "Accept"}
                        </Button>
                        <Button onClick={() => rejectInterest(profile)} disabled={isProcessing}>
                            Reject
                        </Button>
                    </Box>
                </CardContent>
            </InterestCard>
        </Grid>
    );
})}









