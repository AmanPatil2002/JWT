const db = require("../config/database");


const addInterested = (req, res) => {
    const { requesterEmail, profileId, } = req.body;

    if (!requesterEmail || !profileId) {
        return res.status(400).json({ error: "requesterEmail and profileId are required" });
    }
    const checkSql = "SELECT * FROM interested WHERE RequesterEmail = ? AND ProfileID = ?";
    db.query(checkSql, [requesterEmail, profileId], (err, existing) => {
        if (err) {
            console.error("Error checking interested list:", err);
            return res.status(500).json({ error: "Database error", details: err.message });
        }
        if (existing.length > 0) {
            return res.status(200).json({ message: "Already in interested list", interested: existing[0] });
        }
        const sql = "INSERT INTO interested (RequesterEmail, ProfileID) VALUES (?, ?)";
        db.query(sql, [requesterEmail, profileId || null], (err, result) => {
            if (err) {
                console.error("Error adding to interested list:", err);
                return res.status(500).json({ error: "Failed to add to interested list", details: err.message });
            }
            res.status(201).json({
                message: "Added to interested list",
                interested: {
                    id: result.insertId,
                    requesterEmail,
                    profileId,
                },
            });
        });
    });
};

const getInterested = (req, res) => {
    const { email } = req.params;

    if (!email) {
        return res.status(400).json({
            error: "Email is required"
        });
    }
    const sql = `
        SELECT
            i.ID,
            i.RequesterEmail,
            i.ProfileID,
            p.*
        FROM interested i
        INNER JOIN profile p
            ON p.RegisterID = i.ProfileID
        WHERE i.RequesterEmail = ?
        ORDER BY i.CreatedAt DESC
    `;

    db.query(sql, [email], (err, results) => {
        if (err) {
            console.error("Error fetching interested profiles:", err);
            return res.status(500).json({
                error: "Database error",
                details: err.message
            });
        }
        res.status(200).json(results);
    });
};


const AllInterested = (req, res) => {
    db.query("SELECT * FROM interested", (err, result) => {
        if (err) return res.status(500).json(err);
        res.json(result);
    });
};

const updateInterest = (req, res) => {
    const { requesterEmail, profileId, intrest } = req.body;

    if (!requesterEmail || !profileId || !intrest) {
        return res.status(400).json({
            error: "requesterEmail, profileId and intrest are required"
        });
    }
    const sql = `UPDATE interested SET Intrest = ? WHERE RequesterEmail = ? AND ProfileID = ? `;

    db.query(
        sql,
        [intrest, requesterEmail, profileId],
        (err, result) => {
            if (err) {
                console.error("Error updating interest:", err);
                return res.status(500).json({
                    error: "Database error",
                    details: err.message
                });
            }

            if (result.affectedRows === 0) {
                return res.status(404).json({
                    error: "Interested record not found"
                });
            }

            res.status(200).json({
                message: "Interest updated successfully",
                requesterEmail,
                profileId,
                intrest
            });
        }
    );
};


const deleteInterest = (req, res) => {
    const { requesterEmail, profileId } = req.body;

    if (!requesterEmail || !profileId ) {
        return res.status(400).json({
            error: "requesterEmail, profileId are required"
        });
    }
    const sql = `DELETE FROM interested WHERE RequesterEmail = ? AND ProfileID = ?`;

    db.query(
        sql,
        [ requesterEmail, profileId],
        (err, result) => {
            if (err) {
                console.error("Error deleting interest:", err);
                return res.status(500).json({
                    error: "Database error",
                    details: err.message
                });
            }

            if (result.affectedRows === 0) {
                return res.status(404).json({
                    error: "Interested record not found"
                });
            }

            res.status(200).json({
                message: "Interest deleted successfully",
                requesterEmail,
                profileId,
            });
        }
    );
};

