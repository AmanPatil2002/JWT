const ProfileDetailDialog = ({
    detailOpen,
    setDetailOpen,
    selectedProfile,
    getImageUrl,
    handleSendInterest,
}) => {
    const profileId = selectedProfile?.RegisterID;
    const interestStatus = profileId ? interestStatusMap[profileId] : null;
    const isSending = sendingInterestId === profileId;

    return (
        <Dialog ...>
            ...
            {interestStatus === 'no-profile' && (
                <Typography variant="body2" color="warning.main">
                    Please Create Profile To add Interest
                </Typography>
            )}
            {interestStatus === 'success' && (
                <Typography variant="body2" color="success.main">
                    Interest sent successfully!
                </Typography>
            )}
            {interestStatus === 'already-sent' && (
                <Typography variant="body2" color="info.main">
                    You've already sent interest to this profile.
                </Typography>
            )}
            {interestStatus === 'error' && (
                <Typography variant="body2" color="error.main">
                    Failed to send interest. Please try again.
                </Typography>
            )}
            ...
            <Button
                variant="contained"
                fullWidth
                disabled={isSending || interestStatus === 'success' || interestStatus === 'already-sent'}
                sx={{ minWidth: { sm: 160 }, background: 'linear-gradient(45deg, #c2185b 30%, #e91e63 90%)' }}
                onClick={() => {
                    if (!hasProfile) {
                        navigate('/profile');
                        return;
                    }
                    handleSendInterest(selectedProfile);
                }}
            >
                {!hasProfile
                    ? 'Create Profile First'
                    : isSending
                        ? 'Sending...'
                        : interestStatus === 'success'
                            ? 'Sent'
                            : interestStatus === 'already-sent'
                                ? 'Already Sent'
                                : 'Send Interest'}
            </Button>
        </Dialog>
    );
};
